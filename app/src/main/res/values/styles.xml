<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#00E5FF</color>
    <color name="accent2">#FF2E88</color>
    <color name="panel">#CC0A0E1A</color>
    <color name="glass">#990A0E1A</color>
    <color name="stroke">#4D00E5FF</color>
    <color name="text">#FFFFFFFF</color>
    <color name="text_dim">#B3FFFFFF</color>
    <color name="bat_low">#FF3B5C</color>
    <color name="bat_mid">#FFB020</color>
    <color name="bat_charge">#39FF88</color>

    <!-- Fondo transparente: se ve el fondo de pantalla del teléfono -->
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="PopupTheme" parent="android:Theme.Material">
        <item name="android:colorBackground">#F20A0E1A</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>
</resources>
