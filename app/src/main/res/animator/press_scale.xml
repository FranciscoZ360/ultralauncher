<?xml version="1.0" encoding="utf-8"?>
<!-- Los íconos se achican un poco mientras se presionan -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.88" android:duration="90" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.88" android:duration="90" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="140" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="140" />
        </set>
    </item>
</selector>
